<Window x:Class="WECPBXR18.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WECPBXR18.UI.ViewModels"
        mc:Ignorable="d"
        Title="WECPBXR18"
        Width="1040"
        Height="780"
        MinWidth="1040"
        MinHeight="780"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <Style x:Key="PanelButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="42" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Foreground" Value="#EAF0F7" />
            <Setter Property="Background" Value="#303640" />
            <Setter Property="BorderBrush" Value="#68727F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="PanelTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Width" Value="78" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Foreground" Value="#EAF0F7" />
            <Setter Property="Background" Value="#171A20" />
            <Setter Property="BorderBrush" Value="#59616E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <Style x:Key="PanelComboBoxStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Width" Value="110" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="#11151B" />
            <Setter Property="Background" Value="#C2CAD4" />
            <Setter Property="BorderBrush" Value="#59616E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <Style x:Key="ControllerButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="58" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="#1F2630" />
            <Setter Property="Background" Value="#BFC8D3" />
            <Setter Property="BorderBrush" Value="#050609" />
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="WindowControlButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Foreground" Value="#F5F7FA" />
            <Setter Property="Background" Value="#323842" />
            <Setter Property="BorderBrush" Value="#59616E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="CanvasItemStyle" TargetType="{x:Type ContentPresenter}">
            <Setter Property="Canvas.Left" Value="{Binding Left}" />
            <Setter Property="Canvas.Top" Value="{Binding Top}" />
            <Setter Property="Width" Value="{Binding Width}" />
            <Setter Property="Height" Value="{Binding Height}" />
        </Style>

        <DataTemplate x:Key="ValueBarsTemplate" DataType="{x:Type vm:ControlSlotViewModel}">
            <StackPanel>
                <Grid Height="5" Margin="8,2,8,1" HorizontalAlignment="Stretch">
                    <Border Background="#11151B" BorderBrush="#3D4550" BorderThickness="1" />
                    <Rectangle Fill="#4BA3FF"
                               Width="{Binding ControllerBarWidth}"
                               HorizontalAlignment="Left"
                               Margin="1" />
                </Grid>
                <Grid Height="5" Margin="8,1,8,0" HorizontalAlignment="Stretch">
                    <Border Background="#11151B" BorderBrush="#3D4550" BorderThickness="1" />
                    <Rectangle Fill="#F2C84B"
                               Width="{Binding MixerBarWidth}"
                               HorizontalAlignment="Left"
                               Margin="1" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="KnobTemplate" DataType="{x:Type vm:ControlSlotViewModel}">
            <Grid ToolTip="{Binding BindingText}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="18" />
                    <RowDefinition Height="52" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="18" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="{Binding Label}"
                           Foreground="#EDF2F7"
                           FontSize="9"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Grid Grid.Row="1">
                    <Ellipse Width="46"
                             Height="46"
                             Fill="#20242C"
                             Stroke="#515A67"
                             StrokeThickness="2" />
                    <Ellipse Width="34"
                             Height="34"
                             Fill="#353A45"
                             Stroke="#0E1015"
                             StrokeThickness="2" />
                    <Rectangle Width="4"
                               Height="19"
                               Fill="#9BA7B6"
                               RadiusX="2"
                               RadiusY="2"
                               VerticalAlignment="Top"
                               Margin="0,6,0,0" />
                </Grid>
                <ContentControl Grid.Row="2" Content="{Binding}" ContentTemplate="{StaticResource ValueBarsTemplate}" />
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding ControllerText}" Foreground="#9FCBFF" FontSize="8" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding MixerText}" Foreground="#FFE08A" FontSize="8" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ButtonTemplate" DataType="{x:Type vm:ControlSlotViewModel}">
            <Grid ToolTip="{Binding BindingText}">
                <Border Background="#C2CAD4"
                        BorderBrush="#050609"
                        BorderThickness="3"
                        CornerRadius="3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="12" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Label}"
                                   Foreground="#202630"
                                   FontSize="8"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Margin="3,0" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding ControllerText}" Foreground="#0F4D86" FontSize="7" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding MixerText}" Foreground="#775A00" FontSize="7" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FaderTemplate" DataType="{x:Type vm:ControlSlotViewModel}">
            <Grid ToolTip="{Binding BindingText}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="22" />
                    <RowDefinition Height="102" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="36" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Label}"
                           Foreground="#F3F6FA"
                           FontSize="10"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Grid Grid.Row="1">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,0,0,4">
                        <StackPanel Margin="0,0,11,0">
                            <Rectangle Width="17" Height="1" Fill="#89919C" Margin="0,0,0,9" />
                            <Rectangle Width="17" Height="1" Fill="#89919C" Margin="0,0,0,9" />
                            <Rectangle Width="17" Height="1" Fill="#89919C" Margin="0,0,0,9" />
                            <Rectangle Width="17" Height="1" Fill="#89919C" Margin="0,0,0,9" />
                            <Rectangle Width="17" Height="1" Fill="#89919C" />
                        </StackPanel>
                        <Grid>
                            <Rectangle Width="12"
                                       Height="96"
                                       Fill="#0C0D10"
                                       Stroke="#3D4550"
                                       StrokeThickness="2"
                                       RadiusX="3"
                                       RadiusY="3" />
                            <Border Width="34"
                                    Height="18"
                                    Background="#262B34"
                                    BorderBrush="#11151B"
                                    BorderThickness="2"
                                    CornerRadius="2"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,10" />
                        </Grid>
                        <StackPanel Margin="11,0,0,0">
                            <Rectangle Width="17" Height="1" Fill="#89919C" Margin="0,0,0,9" />
                            <Rectangle Width="17" Height="1" Fill="#89919C" Margin="0,0,0,9" />
                            <Rectangle Width="17" Height="1" Fill="#89919C" Margin="0,0,0,9" />
                            <Rectangle Width="17" Height="1" Fill="#89919C" Margin="0,0,0,9" />
                            <Rectangle Width="17" Height="1" Fill="#89919C" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <ContentControl Grid.Row="2" Content="{Binding}" ContentTemplate="{StaticResource ValueBarsTemplate}" />
                <StackPanel Grid.Row="3">
                    <TextBlock Text="{Binding ControllerText}" Foreground="#9FCBFF" FontSize="9" TextAlignment="Center" />
                    <TextBlock Text="{Binding MixerText}" Foreground="#FFE08A" FontSize="9" TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Viewbox Stretch="Uniform">
        <Canvas Width="1000" Height="740">
            <Border Canvas.Left="22"
                    Canvas.Top="20"
                    Width="936"
                    Height="700"
                    Background="#24262D"
                    BorderBrush="#050609"
                    BorderThickness="4"
                    CornerRadius="28" />

            <TextBlock Canvas.Left="78"
                       Canvas.Top="66"
                       Text="WORLDE"
                       Foreground="#F5F7FA"
                       FontSize="24"
                       FontWeight="Black"
                       Opacity="0.9" />

            <Border Canvas.Left="74"
                    Canvas.Top="104"
                    Width="112"
                    Height="36"
                    Background="{Binding BankBrush}"
                    BorderBrush="#D8DEE8"
                    BorderThickness="1"
                    CornerRadius="9">
                <TextBlock Text="{Binding BankTitle}"
                           Foreground="{Binding BankTextBrush}"
                           FontSize="13"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="8,0" />
            </Border>

            <Button Canvas.Left="892"
                    Canvas.Top="32"
                    Content="_"
                    Click="MinimizeButton_Click"
                    Style="{StaticResource WindowControlButtonStyle}" />
            <Button Canvas.Left="920"
                    Canvas.Top="32"
                    Content="X"
                    Click="CloseButton_Click"
                    Style="{StaticResource WindowControlButtonStyle}" />

            <TextBlock Canvas.Left="760"
                       Canvas.Top="684"
                       Text="EASYCONTROL PLUS"
                       Foreground="#F5F7FA"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Opacity="0.95" />

            <Button Canvas.Left="82" Canvas.Top="146" Content="BANK L" Command="{Binding BankPreviousCommand}" Style="{StaticResource ControllerButtonStyle}" />
            <Button Canvas.Left="82" Canvas.Top="242" Content="BANK R" Command="{Binding BankNextCommand}" Style="{StaticResource ControllerButtonStyle}" />
            <Button Canvas.Left="82" Canvas.Top="320" Content="SOLO" Style="{StaticResource ControllerButtonStyle}" />
            <Button Canvas.Left="82" Canvas.Top="382" Content="SEND ALL" Style="{StaticResource ControllerButtonStyle}" />

            <StackPanel Canvas.Left="82" Canvas.Top="674" Orientation="Horizontal">
                <TextBox Text="{Binding MixerAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{Binding MixerStatus}"
                         Style="{StaticResource PanelTextBoxStyle}" />
                <Button Content="X+" Command="{Binding ConnectMixerCommand}" ToolTip="{Binding MixerStatus}" Style="{StaticResource PanelButtonStyle}" Margin="0,0,6,0" />
                <Button Content="X-" Command="{Binding DisconnectMixerCommand}" ToolTip="{Binding MixerStatus}" Style="{StaticResource PanelButtonStyle}" Margin="0,0,10,0" />
                <ComboBox ItemsSource="{Binding MidiDevices}"
                          SelectedItem="{Binding SelectedMidiDevice, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          ToolTip="{Binding MidiStatus}"
                          Style="{StaticResource PanelComboBoxStyle}" />
                <Button Content="R" Command="{Binding RefreshMidiDevicesCommand}" ToolTip="{Binding MidiStatus}" Style="{StaticResource PanelButtonStyle}" Margin="0,0,6,0" />
                <Button Content="M+" Command="{Binding ConnectMidiCommand}" ToolTip="{Binding MidiStatus}" Style="{StaticResource PanelButtonStyle}" Margin="0,0,6,0" />
                <Button Content="M-" Command="{Binding DisconnectMidiCommand}" ToolTip="{Binding MidiStatus}" Style="{StaticResource PanelButtonStyle}" Margin="0,0,10,0" />
                <Button Content="Map" Command="{Binding LoadMapCommand}" Style="{StaticResource PanelButtonStyle}" Margin="0,0,6,0" />
                <Button Content="SF" Command="{Binding SimulateFaderCommand}" Style="{StaticResource PanelButtonStyle}" Margin="0,0,6,0" />
                <Button Content="SM" Command="{Binding SimulateMuteCommand}" Style="{StaticResource PanelButtonStyle}" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Knobs}" ItemTemplate="{StaticResource KnobTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <StaticResource ResourceKey="CanvasItemStyle" />
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Buttons}" ItemTemplate="{StaticResource ButtonTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <StaticResource ResourceKey="CanvasItemStyle" />
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Faders}" ItemTemplate="{StaticResource FaderTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <StaticResource ResourceKey="CanvasItemStyle" />
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </Canvas>
    </Viewbox>
</Window>
