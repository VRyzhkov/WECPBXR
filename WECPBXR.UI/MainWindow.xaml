<Window x:Class="WECPBXR.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WECPBXR.UI.ViewModels" d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        mc:Ignorable="d"
        Title="WECPBXR"
        Width="1000"
        Height="760"
        MinWidth="1000"
        MinHeight="760"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <Style x:Key="PanelButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Foreground" Value="#EAF0F7" />
            <Setter Property="Background" Value="#303640" />
            <Setter Property="BorderBrush" Value="#68727F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Width" Value="90" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Foreground" Value="#EAF0F7" />
            <Setter Property="Background" Value="#171A20" />
            <Setter Property="BorderBrush" Value="#59616E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <Style x:Key="PanelComboBoxStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Width" Value="96" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="#11151B" />
            <Setter Property="Background" Value="#C2CAD4" />
            <Setter Property="BorderBrush" Value="#59616E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <Style x:Key="ControllerButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="72" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Foreground" Value="#1F2630" />
            <Setter Property="Background" Value="#BFC8D3" />
            <Setter Property="BorderBrush" Value="#050609" />
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowControlButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Foreground" Value="#F5F7FA" />
            <Setter Property="Background" Value="#323842" />
            <Setter Property="BorderBrush" Value="#59616E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CanvasItemStyle" TargetType="{x:Type ContentPresenter}">
            <Setter Property="Canvas.Left" Value="{Binding Left}" />
            <Setter Property="Canvas.Top" Value="{Binding Top}" />
            <Setter Property="Width" Value="{Binding Width}" />
            <Setter Property="Height" Value="{Binding Height}" />
        </Style>

        <DataTemplate x:Key="ValueBarsTemplate" DataType="{x:Type vm:ControlSlotViewModel}">
            <StackPanel>
                <Grid Height="5" Margin="8,2,8,1" HorizontalAlignment="Stretch">
                    <Border Background="#11151B" BorderBrush="#3D4550" BorderThickness="1" />
                    <Rectangle Fill="#4BA3FF"
                               Width="{Binding ControllerBarWidth}"
                               HorizontalAlignment="Left"
                               Margin="1" />
                </Grid>
                <Grid Height="5" Margin="8,1,8,0" HorizontalAlignment="Stretch">
                    <Border Background="#11151B" BorderBrush="#3D4550" BorderThickness="1" />
                    <Rectangle Fill="#F2C84B"
                               Width="{Binding MixerBarWidth}"
                               HorizontalAlignment="Left"
                               Margin="1" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="KnobTemplate" DataType="{x:Type vm:ControlSlotViewModel}">
            <Grid ToolTip="{Binding BindingText}" PreviewMouseLeftButtonDown="ControlSlot_PreviewMouseLeftButtonDown">
                <Grid.RowDefinitions>
                    <RowDefinition Height="18" />
                    <RowDefinition Height="52" />
                    <RowDefinition Height="16" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="{Binding Label}"
                           Foreground="#EDF2F7"
                           FontSize="9"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Grid Grid.Row="1">
                    <Ellipse Width="46"
                             Height="46"
                             Fill="#20242C"
                             Stroke="#515A67"
                             StrokeThickness="2" />
                    <Ellipse Width="34"
                             Height="34"
                             Fill="#353A45"
                             Stroke="#0E1015"
                             StrokeThickness="2" />
                    <Rectangle Width="4"
                               Height="19"
                               Fill="#9BA7B6"
                               RadiusX="2"
                               RadiusY="2"
                               VerticalAlignment="Top"
                               Margin="0,6,0,0" />
                </Grid>
                <ContentControl Grid.Row="2" Content="{Binding}" ContentTemplate="{StaticResource ValueBarsTemplate}" />
                <Border Grid.RowSpan="3"
                        BorderBrush="{Binding SelectionBorderBrush}"
                        BorderThickness="{Binding SelectionBorderThickness}"
                        CornerRadius="6"
                        IsHitTestVisible="False" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ButtonTemplate" DataType="{x:Type vm:ControlSlotViewModel}">
            <Grid ToolTip="{Binding BindingText}" PreviewMouseLeftButtonDown="ControlSlot_PreviewMouseLeftButtonDown">
                <Border Background="#C2CAD4"
                        BorderBrush="#050609"
                        BorderThickness="3"
                        CornerRadius="3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Label}"
                                   Foreground="#202630"
                                   FontSize="8"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Margin="3,0" />
                    </Grid>
                </Border>
                <Border BorderBrush="{Binding SelectionBorderBrush}"
                        BorderThickness="{Binding SelectionBorderThickness}"
                        CornerRadius="5"
                        IsHitTestVisible="False" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FaderTemplate" DataType="{x:Type vm:ControlSlotViewModel}">
            <Grid ToolTip="{Binding BindingText}" PreviewMouseLeftButtonDown="ControlSlot_PreviewMouseLeftButtonDown">
                <Grid.RowDefinitions>
                    <RowDefinition Height="22" />
                    <RowDefinition Height="102" />
                    <RowDefinition Height="18" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Label}"
                           Foreground="#F3F6FA"
                           FontSize="10"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Grid Grid.Row="1">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,0,0,4">
                        <StackPanel Margin="0,0,5,0">
                            <Rectangle Width="13" Height="1" Fill="#89919C" Margin="0,0,0,9" />
                            <Rectangle Width="13" Height="1" Fill="#89919C" Margin="0,0,0,9" />
                            <Rectangle Width="13" Height="1" Fill="#89919C" Margin="0,0,0,9" />
                            <Rectangle Width="13" Height="1" Fill="#89919C" Margin="0,0,0,9" />
                            <Rectangle Width="13" Height="1" Fill="#89919C" />
                        </StackPanel>
                        <Grid>
                            <Rectangle Width="12"
                                       Height="96"
                                       Fill="#0C0D10"
                                       Stroke="#3D4550"
                                       StrokeThickness="2"
                                       RadiusX="3"
                                       RadiusY="3" />
                            <Border Width="34"
                                    Height="18"
                                    Background="#262B34"
                                    BorderBrush="#11151B"
                                    BorderThickness="2"
                                    CornerRadius="2"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,10" />
                        </Grid>
                        <StackPanel Margin="5,0,0,0">
                            <Rectangle Width="13" Height="1" Fill="#89919C" Margin="0,0,0,9" />
                            <Rectangle Width="13" Height="1" Fill="#89919C" Margin="0,0,0,9" />
                            <Rectangle Width="13" Height="1" Fill="#89919C" Margin="0,0,0,9" />
                            <Rectangle Width="13" Height="1" Fill="#89919C" Margin="0,0,0,9" />
                            <Rectangle Width="13" Height="1" Fill="#89919C" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <ContentControl Grid.Row="2" Content="{Binding}" ContentTemplate="{StaticResource ValueBarsTemplate}" />
                <Border Grid.RowSpan="3"
                        BorderBrush="{Binding SelectionBorderBrush}"
                        BorderThickness="{Binding SelectionBorderThickness}"
                        CornerRadius="6"
                        IsHitTestVisible="False" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Viewbox Stretch="Uniform">
        <Canvas Width="960" Height="724">
            <Border Canvas.Left="50"
                    Canvas.Top="20"
                    Width="884"
                    Height="680"
                    Background="#24262D"
                    BorderBrush="#050609"
                    BorderThickness="4"
                    CornerRadius="28" />

            <TextBlock Canvas.Left="78"
                       Canvas.Top="66"
                       Text="WORLDE"
                       Foreground="#F5F7FA"
                       FontSize="24"
                       FontWeight="Black"
                       Opacity="0.9" />

            <Border Canvas.Left="74"
                    Canvas.Top="104"
                    Width="112"
                    Height="36"
                    Background="{Binding BankBrush}"
                    BorderBrush="#D8DEE8"
                    BorderThickness="1"
                    CornerRadius="9">
                <TextBlock Text="{Binding BankTitle}"
                           Foreground="{Binding BankTextBrush}"
                           FontSize="13"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="8,0" />
            </Border>

            <TextBlock Canvas.Left="730"
                       Canvas.Top="632"
                       Text="{Binding SoftwareVersionText}"
                       Foreground="#B7C0CC"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Opacity="0.9" />

            <TextBlock Canvas.Left="730"
                       Canvas.Top="648"
                       Text="EASYCONTROL PLUS"
                       Foreground="#F5F7FA"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Opacity="0.95" />

            <StackPanel Canvas.Left="78" Canvas.Top="31" Orientation="Horizontal" Visibility="{Binding NormalPanelVisibility}">
                <Ellipse Width="9" Height="9" Fill="{Binding MixerIndicatorBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                <TextBox Text="{Binding MixerAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{Binding MixerStatus}"
                         Style="{StaticResource PanelTextBoxStyle}" />
                <Button Content="X+" Command="{Binding ConnectMixerCommand}" ToolTip="Connect to XR" Style="{StaticResource PanelButtonStyle}" Margin="0,0,6,0" />
                <Button Content="X-" Command="{Binding DisconnectMixerCommand}" ToolTip="Disconnect from XR" Style="{StaticResource PanelButtonStyle}" Margin="0,0,10,0" />
                <Button Content="Pull" Command="{Binding RequestMixerValuesCommand}" ToolTip="Request current values for assigned OSC addresses" Style="{StaticResource PanelButtonStyle}" Margin="0,0,10,0" />
                <Ellipse Width="9" Height="9" Fill="{Binding MidiIndicatorBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                <ComboBox ItemsSource="{Binding MidiDevices}"
                          SelectedItem="{Binding SelectedMidiDevice, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          ToolTip="{Binding MidiStatus}"
                          Style="{StaticResource PanelComboBoxStyle}" />
                <Button Content="R" Command="{Binding RefreshMidiDevicesCommand}" ToolTip="Refresh MIDI device list" Style="{StaticResource PanelButtonStyle}" Margin="0,0,6,0" />
                <Button Content="M+" Command="{Binding ConnectMidiCommand}" ToolTip="Connect selected MIDI input" Style="{StaticResource PanelButtonStyle}" Margin="0,0,6,0" />
                <Button Content="M-" Command="{Binding DisconnectMidiCommand}" ToolTip="Disconnect MIDI input" Style="{StaticResource PanelButtonStyle}" Margin="0,0,10,0" />
                <Button Content="Map" Command="{Binding LoadMapCommand}" ToolTip="Load MIDI/OSC map from midi-map.json" Style="{StaticResource PanelButtonStyle}" Margin="0,0,6,0" />
                <Button Content="Assign" Command="{Binding ToggleAssignmentModeCommand}" ToolTip="Open function assignment mode" Style="{StaticResource PanelButtonStyle}" Margin="0,0,6,0" />
                <Button Content="Check" Command="{Binding CheckMapCommand}" ToolTip="Check map for duplicate MIDI and missing or unknown OSC bindings" Style="{StaticResource PanelButtonStyle}" Margin="0,0,6,0" />
                <Button Content="SF" Command="{Binding SimulateFaderCommand}" ToolTip="Simulate channel 1 fader movement" Style="{StaticResource PanelButtonStyle}" Margin="0,0,6,0" />
                <Button Content="SM" Command="{Binding SimulateMuteCommand}" ToolTip="Simulate channel 1 mute button press" Style="{StaticResource PanelButtonStyle}" />
            </StackPanel>

            <StackPanel Canvas.Left="78" Canvas.Top="31" Orientation="Horizontal" Visibility="{Binding AssignmentPanelVisibility}">
                <Button Content="{Binding AssignmentModeText}" Command="{Binding ToggleAssignmentModeCommand}" ToolTip="Close function assignment mode" Style="{StaticResource PanelButtonStyle}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding SelectedSlotText}"
                           Width="78"
                           Foreground="#EAF0F7"
                           FontSize="10"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding AssignmentCommands}"
                          SelectedItem="{Binding SelectedAssignmentCommand, Mode=TwoWay}"
                          Style="{StaticResource PanelComboBoxStyle}"
                          Width="86" />
                <TextBox Text="{Binding AssignmentChannel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="XR channel 1-18"
                         Style="{StaticResource PanelTextBoxStyle}"
                         Width="34" />
                <TextBox Text="{Binding AssignmentIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Bus/FX index. Empty for main, mute, pan."
                         Style="{StaticResource PanelTextBoxStyle}"
                         Width="34" />
                <TextBox Text="{Binding AssignmentMidiChannel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="MIDI channel 1-16"
                         Style="{StaticResource PanelTextBoxStyle}"
                         Width="34" />
                <TextBox Text="{Binding AssignmentMidiNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="MIDI CC number 0-127"
                         Style="{StaticResource PanelTextBoxStyle}"
                         Width="34" />
                <Button Content="MIDI" Command="{Binding ApplyMidiBindingCommand}" ToolTip="Assign MIDI Control Change to selected control" Style="{StaticResource PanelButtonStyle}" Margin="0,0,6,0" />
                <Button Content="Set" Command="{Binding ApplyAssignmentCommand}" ToolTip="Assign selected function to selected control" Style="{StaticResource PanelButtonStyle}" Margin="0,0,6,0" />
                <Button Content="Clear" Command="{Binding ClearAssignmentCommand}" ToolTip="Clear mixer function from selected control" Style="{StaticResource PanelButtonStyle}" Margin="0,0,6,0" />
                <Button Content="Learn" Command="{Binding LearnMidiCommand}" ToolTip="Learn MIDI binding from the next physical controller event" Style="{StaticResource PanelButtonStyle}" Margin="0,0,6,0" />
                <Button Content="Check" Command="{Binding CheckMapCommand}" ToolTip="Check map for duplicate MIDI and missing or unknown OSC bindings" Style="{StaticResource PanelButtonStyle}" Margin="0,0,6,0" />
                <Button Content="{Binding SaveMapText}" Command="{Binding SaveMapCommand}" ToolTip="Save current MIDI/OSC map to midi-map.json" Style="{StaticResource PanelButtonStyle}" />
            </StackPanel>

            <StackPanel Canvas.Left="842" Canvas.Top="31" Orientation="Horizontal">
                <Button Content="_" Click="MinimizeButton_Click" Style="{StaticResource WindowControlButtonStyle}" Margin="0,0,8,0" />
                <Button Content="X" Click="CloseButton_Click" Style="{StaticResource WindowControlButtonStyle}" />
            </StackPanel>

            <Border Canvas.Left="82"
                    Canvas.Top="628"
                    Width="630"
                    Height="48"
                    Background="#D920242B"
                    BorderBrush="#59616E"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding LogEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Foreground="#D8DEE8"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <ItemsControl ItemsSource="{Binding Knobs}" ItemTemplate="{StaticResource KnobTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <StaticResource ResourceKey="CanvasItemStyle" />
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Buttons}" ItemTemplate="{StaticResource ButtonTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <StaticResource ResourceKey="CanvasItemStyle" />
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Faders}" ItemTemplate="{StaticResource FaderTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <StaticResource ResourceKey="CanvasItemStyle" />
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </Canvas>
    </Viewbox>
</Window>
