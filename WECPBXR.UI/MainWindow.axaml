<Window x:Class="WECPBXR.UI.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WECPBXR.UI.ViewModels"
        Title="WECPBXR"
        Width="1000"
        Height="760"
        MinWidth="1000"
        MinHeight="760"
        CanResize="False"
        WindowDecorations="None"
        Background="Transparent"
        FontFamily="Segoe UI"
        PointerPressed="Window_PointerPressed">
  <Window.Styles>
    <Style Selector="Button.panel">
      <Setter Property="Height" Value="28" />
      <Setter Property="MinWidth" Value="36" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="Foreground" Value="#EAF0F7" />
      <Setter Property="Background" Value="#303640" />
      <Setter Property="BorderBrush" Value="#68727F" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="Button.window-control">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="#F5F7FA" />
      <Setter Property="Background" Value="#323842" />
      <Setter Property="BorderBrush" Value="#59616E" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>

    <Style Selector="TextBox.panel">
      <Setter Property="Height" Value="28" />
      <Setter Property="Width" Value="90" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Foreground" Value="#EAF0F7" />
      <Setter Property="Background" Value="#171A20" />
      <Setter Property="BorderBrush" Value="#59616E" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="10" />
    </Style>

    <Style Selector="ComboBox.panel">
      <Setter Property="Height" Value="28" />
      <Setter Property="Width" Value="96" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Foreground" Value="#11151B" />
      <Setter Property="Background" Value="#C2CAD4" />
      <Setter Property="BorderBrush" Value="#59616E" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="10" />
    </Style>
  </Window.Styles>

  <Window.Resources>
    <DataTemplate x:Key="MidiDeviceTemplate">
      <TextBlock Text="{Binding Name}" />
    </DataTemplate>

    <DataTemplate x:Key="ValueBarsTemplate" DataType="vm:ControlSlotViewModel">
      <StackPanel>
        <Grid Height="5" Margin="8,2,8,1" HorizontalAlignment="Stretch">
          <Border Background="#11151B" BorderBrush="#3D4550" BorderThickness="1" />
          <Rectangle Fill="#4BA3FF"
                     Width="{Binding ControllerBarWidth}"
                     HorizontalAlignment="Left"
                     Margin="1" />
        </Grid>
        <Grid Height="5" Margin="8,1,8,0" HorizontalAlignment="Stretch">
          <Border Background="#11151B" BorderBrush="#3D4550" BorderThickness="1" />
          <Rectangle Fill="#F2C84B"
                     Width="{Binding MixerBarWidth}"
                     HorizontalAlignment="Left"
                     Margin="1" />
        </Grid>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="KnobTemplate" DataType="vm:ControlSlotViewModel">
      <Grid ToolTip.Tip="{Binding BindingText}" PointerPressed="ControlSlot_PointerPressed">
        <Grid.RowDefinitions>
          <RowDefinition Height="18" />
          <RowDefinition Height="52" />
          <RowDefinition Height="16" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Text="{Binding Label}"
                   Foreground="#EDF2F7"
                   FontSize="9"
                   FontWeight="SemiBold"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <Grid Grid.Row="1">
          <Ellipse Width="46"
                   Height="46"
                   Fill="#20242C"
                   Stroke="#515A67"
                   StrokeThickness="2" />
          <Ellipse Width="34"
                   Height="34"
                   Fill="#353A45"
                   Stroke="#0E1015"
                   StrokeThickness="2" />
          <Rectangle Width="4"
                     Height="19"
                     Fill="#9BA7B6"
                     RadiusX="2"
                     RadiusY="2"
                     VerticalAlignment="Top"
                     Margin="0,6,0,0" />
        </Grid>
        <ContentControl Grid.Row="2" Content="{Binding}" ContentTemplate="{StaticResource ValueBarsTemplate}" />
        <Border Grid.RowSpan="3"
                BorderBrush="{Binding SelectionBorderBrush}"
                BorderThickness="{Binding SelectionBorderThickness}"
                CornerRadius="6"
                IsHitTestVisible="False" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ButtonTemplate" DataType="vm:ControlSlotViewModel">
      <Grid ToolTip.Tip="{Binding BindingText}" PointerPressed="ControlSlot_PointerPressed">
        <Border Background="#C2CAD4"
                BorderBrush="#050609"
                BorderThickness="3"
                CornerRadius="3">
          <TextBlock Text="{Binding Label}"
                     Foreground="#202630"
                     FontSize="8"
                     FontWeight="Bold"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center"
                     Margin="3,0" />
        </Border>
        <Border BorderBrush="{Binding SelectionBorderBrush}"
                BorderThickness="{Binding SelectionBorderThickness}"
                CornerRadius="5"
                IsHitTestVisible="False" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="FaderTemplate" DataType="vm:ControlSlotViewModel">
      <Grid ToolTip.Tip="{Binding BindingText}" PointerPressed="ControlSlot_PointerPressed">
        <Grid.RowDefinitions>
          <RowDefinition Height="22" />
          <RowDefinition Height="102" />
          <RowDefinition Height="18" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Label}"
                   Foreground="#F3F6FA"
                   FontSize="10"
                   FontWeight="SemiBold"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <Grid Grid.Row="1">
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="0,0,0,4">
            <StackPanel Margin="0,0,5,0">
              <Rectangle Width="13" Height="1" Fill="#89919C" Margin="0,0,0,9" />
              <Rectangle Width="13" Height="1" Fill="#89919C" Margin="0,0,0,9" />
              <Rectangle Width="13" Height="1" Fill="#89919C" Margin="0,0,0,9" />
              <Rectangle Width="13" Height="1" Fill="#89919C" Margin="0,0,0,9" />
              <Rectangle Width="13" Height="1" Fill="#89919C" />
            </StackPanel>
            <Grid>
              <Rectangle Width="12"
                         Height="96"
                         Fill="#0C0D10"
                         Stroke="#3D4550"
                         StrokeThickness="2"
                         RadiusX="3"
                         RadiusY="3" />
              <Border Width="34"
                      Height="18"
                      Background="#262B34"
                      BorderBrush="#11151B"
                      BorderThickness="2"
                      CornerRadius="2"
                      VerticalAlignment="Bottom"
                      Margin="0,0,0,10" />
            </Grid>
            <StackPanel Margin="5,0,0,0">
              <Rectangle Width="13" Height="1" Fill="#89919C" Margin="0,0,0,9" />
              <Rectangle Width="13" Height="1" Fill="#89919C" Margin="0,0,0,9" />
              <Rectangle Width="13" Height="1" Fill="#89919C" Margin="0,0,0,9" />
              <Rectangle Width="13" Height="1" Fill="#89919C" Margin="0,0,0,9" />
              <Rectangle Width="13" Height="1" Fill="#89919C" />
            </StackPanel>
          </StackPanel>
        </Grid>
        <ContentControl Grid.Row="2" Content="{Binding}" ContentTemplate="{StaticResource ValueBarsTemplate}" />
        <Border Grid.RowSpan="3"
                BorderBrush="{Binding SelectionBorderBrush}"
                BorderThickness="{Binding SelectionBorderThickness}"
                CornerRadius="6"
                IsHitTestVisible="False" />
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Viewbox Stretch="Uniform">
    <Canvas Width="960" Height="724">
      <Border Canvas.Left="50"
              Canvas.Top="20"
              Width="884"
              Height="680"
              Background="#24262D"
              BorderBrush="#050609"
              BorderThickness="4"
              CornerRadius="28" />

      <TextBlock Canvas.Left="78"
                 Canvas.Top="66"
                 Text="WORLDE"
                 Foreground="#F5F7FA"
                 FontSize="24"
                 FontWeight="Black"
                 Opacity="0.9" />

      <Border Canvas.Left="74"
              Canvas.Top="104"
              Width="112"
              Height="36"
              Background="{Binding BankBrush}"
              BorderBrush="#D8DEE8"
              BorderThickness="1"
              CornerRadius="9"
              ToolTip.Tip="{Binding BankTitle}">
        <TextBlock Text="{Binding BankTitle}"
                   Foreground="{Binding BankTextBrush}"
                   FontSize="13"
                   FontWeight="Bold"
                   TextAlignment="Center"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Margin="8,0" />
      </Border>

      <TextBlock Canvas.Left="730"
                 Canvas.Top="632"
                 Text="{Binding SoftwareVersionText}"
                 Foreground="#B7C0CC"
                 FontSize="10"
                 FontWeight="SemiBold"
                 Opacity="0.9" />

      <TextBlock Canvas.Left="730"
                 Canvas.Top="648"
                 Text="EASYCONTROL PLUS"
                 Foreground="#F5F7FA"
                 FontSize="17"
                 FontWeight="SemiBold"
                 Opacity="0.95" />

      <StackPanel Canvas.Left="78" Canvas.Top="31" Orientation="Horizontal" IsVisible="{Binding IsNormalPanelVisible}">
        <Ellipse Width="9" Height="9" Fill="{Binding MixerIndicatorBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
        <TextBox Text="{Binding MixerAddress, Mode=TwoWay}"
                 ToolTip.Tip="{Binding MixerStatus}"
                 Classes="panel" />
        <Button Content="X+" Command="{Binding ConnectMixerCommand}" ToolTip.Tip="Connect to XR" Classes="panel" Margin="0,0,6,0" />
        <Button Content="X-" Command="{Binding DisconnectMixerCommand}" ToolTip.Tip="Disconnect from XR" Classes="panel" Margin="0,0,10,0" />
        <Button Content="Pull" Command="{Binding RequestMixerValuesCommand}" ToolTip.Tip="Request current values for assigned OSC addresses" Classes="panel" Margin="0,0,10,0" />
        <Ellipse Width="9" Height="9" Fill="{Binding MidiIndicatorBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
        <ComboBox ItemsSource="{Binding MidiDevices}"
                  SelectedItem="{Binding SelectedMidiDevice, Mode=TwoWay}"
                  ItemTemplate="{StaticResource MidiDeviceTemplate}"
                  ToolTip.Tip="{Binding MidiStatus}"
                  Classes="panel" />
        <Button Content="R" Command="{Binding RefreshMidiDevicesCommand}" ToolTip.Tip="Refresh MIDI device list" Classes="panel" Margin="0,0,6,0" />
        <Button Content="M+" Command="{Binding ConnectMidiCommand}" ToolTip.Tip="Connect selected MIDI input" Classes="panel" Margin="0,0,6,0" />
        <Button Content="M-" Command="{Binding DisconnectMidiCommand}" ToolTip.Tip="Disconnect MIDI input" Classes="panel" Margin="0,0,10,0" />
        <Button Content="Map" Command="{Binding LoadMapCommand}" ToolTip.Tip="Load MIDI/OSC map from midi-map.json" Classes="panel" Margin="0,0,6,0" />
        <Button Content="Assign" Command="{Binding ToggleAssignmentModeCommand}" ToolTip.Tip="Open function assignment mode" Classes="panel" Margin="0,0,6,0" />
        <Button Content="Check" Command="{Binding CheckMapCommand}" ToolTip.Tip="Check map for duplicate MIDI and missing or unknown OSC bindings" Classes="panel" Margin="0,0,6,0" />
        <Button Content="SF" Command="{Binding SimulateFaderCommand}" ToolTip.Tip="Simulate channel 1 fader movement" Classes="panel" Margin="0,0,6,0" />
        <Button Content="SM" Command="{Binding SimulateMuteCommand}" ToolTip.Tip="Simulate channel 1 mute button press" Classes="panel" />
      </StackPanel>

      <StackPanel Canvas.Left="78" Canvas.Top="31" Orientation="Horizontal" IsVisible="{Binding IsAssignmentPanelVisible}">
        <Button Content="{Binding AssignmentModeText}" Command="{Binding ToggleAssignmentModeCommand}" ToolTip.Tip="Close function assignment mode" Classes="panel" Margin="0,0,8,0" />
        <TextBlock Text="{Binding SelectedSlotText}"
                   Width="78"
                   Foreground="#EAF0F7"
                   FontSize="10"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,0,8,0" />
        <ComboBox ItemsSource="{Binding AssignmentCommands}"
                  SelectedItem="{Binding SelectedAssignmentCommand, Mode=TwoWay}"
                  Width="86"
                  Classes="panel" />
        <TextBox Text="{Binding AssignmentChannel, Mode=TwoWay}" ToolTip.Tip="XR channel 1-18" Width="34" Classes="panel" />
        <TextBox Text="{Binding AssignmentIndex, Mode=TwoWay}" ToolTip.Tip="Bus/FX index. Empty for main, mute, pan." Width="34" Classes="panel" />
        <TextBox Text="{Binding AssignmentMidiChannel, Mode=TwoWay}" ToolTip.Tip="MIDI channel 1-16" Width="34" Classes="panel" />
        <TextBox Text="{Binding AssignmentMidiNumber, Mode=TwoWay}" ToolTip.Tip="MIDI CC number 0-127" Width="34" Classes="panel" />
        <Button Content="MIDI" Command="{Binding ApplyMidiBindingCommand}" ToolTip.Tip="Assign MIDI Control Change to selected control" Classes="panel" Margin="0,0,6,0" />
        <Button Content="Set" Command="{Binding ApplyAssignmentCommand}" ToolTip.Tip="Assign selected function to selected control" Classes="panel" Margin="0,0,6,0" />
        <Button Content="Clear" Command="{Binding ClearAssignmentCommand}" ToolTip.Tip="Clear mixer function from selected control" Classes="panel" Margin="0,0,6,0" />
        <Button Content="Learn" Command="{Binding LearnMidiCommand}" ToolTip.Tip="Learn MIDI binding from the next physical controller event" Classes="panel" Margin="0,0,6,0" />
        <Button Content="Check" Command="{Binding CheckMapCommand}" ToolTip.Tip="Check map for duplicate MIDI and missing or unknown OSC bindings" Classes="panel" Margin="0,0,6,0" />
        <Button Content="{Binding SaveMapText}" Command="{Binding SaveMapCommand}" ToolTip.Tip="Save current MIDI/OSC map to midi-map.json" Classes="panel" />
      </StackPanel>

      <StackPanel Canvas.Left="806" Canvas.Top="35" Orientation="Horizontal">
        <Button x:Name="ScaleButton"
                Click="ScaleButton_Click"
                Classes="window-control"
                Margin="0,0,8,0"
                ToolTip.Tip="Reduce window size">
          <Grid Width="14" Height="14">
            <Path x:Name="ScaleIcon"
                  Data="M 2 2 L 6 6 M 6 6 L 6 3 M 6 6 L 3 6 M 12 12 L 8 8 M 8 8 L 11 8 M 8 8 L 8 11"
                  Stroke="#F5F7FA"
                  StrokeThickness="1.6"
                  StrokeLineCap="Round"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
          </Grid>
        </Button>
        <Button x:Name="TopmostButton"
                Click="TopmostButton_Click"
                Classes="window-control"
                Margin="0,0,8,0"
                ToolTip.Tip="Pin window on top">
          <Grid Width="14" Height="14">
            <Path x:Name="TopmostPinIcon"
                  Data="M 5 2 L 9 2 M 7 2 L 7 6 M 4 6 L 10 6 M 5 6 L 3 9 M 9 6 L 11 9 M 4 9 L 10 9 M 7 9 L 7 12"
                  Stroke="#F5F7FA"
                  StrokeThickness="1.6"
                  StrokeLineCap="Round"
                  RenderTransformOrigin="50%,50%"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
          </Grid>
        </Button>
        <Button Click="MinimizeButton_Click"
                Classes="window-control"
                Margin="0,0,8,0"
                ToolTip.Tip="Minimize">
          <TextBlock Text="-"
                     Foreground="#F5F7FA"
                     FontSize="16"
                     FontWeight="Bold"
                     TextAlignment="Center"
                     VerticalAlignment="Center"
                     Margin="0,-3,0,0" />
        </Button>
        <Button Click="CloseButton_Click"
                Classes="window-control"
                ToolTip.Tip="Close">
          <Grid Width="14" Height="14">
            <Path Data="M 3 3 L 11 11 M 11 3 L 3 11"
                  Stroke="#F5F7FA"
                  StrokeThickness="2"
                  StrokeLineCap="Round"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
          </Grid>
        </Button>
      </StackPanel>

      <Border Canvas.Left="82"
              Canvas.Top="628"
              Width="630"
              Height="48"
              Background="#D920242B"
              BorderBrush="#59616E"
              BorderThickness="1"
              CornerRadius="4"
              Padding="6"
              PointerPressed="LogPanel_PointerPressed"
              ToolTip.Tip="Double-click to copy the log to clipboard">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding LogEntries}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}"
                           Foreground="#D8DEE8"
                           FontSize="10"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,2" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <ItemsControl Width="960" Height="724" ItemsSource="{Binding Knobs}" ItemTemplate="{StaticResource KnobTemplate}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerTheme>
          <ControlTheme TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding Left}" />
            <Setter Property="Canvas.Top" Value="{Binding Top}" />
            <Setter Property="Width" Value="{Binding Width}" />
            <Setter Property="Height" Value="{Binding Height}" />
          </ControlTheme>
        </ItemsControl.ItemContainerTheme>
      </ItemsControl>

      <ItemsControl Width="960" Height="724" ItemsSource="{Binding Buttons}" ItemTemplate="{StaticResource ButtonTemplate}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerTheme>
          <ControlTheme TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding Left}" />
            <Setter Property="Canvas.Top" Value="{Binding Top}" />
            <Setter Property="Width" Value="{Binding Width}" />
            <Setter Property="Height" Value="{Binding Height}" />
          </ControlTheme>
        </ItemsControl.ItemContainerTheme>
      </ItemsControl>

      <ItemsControl Width="960" Height="724" ItemsSource="{Binding Faders}" ItemTemplate="{StaticResource FaderTemplate}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerTheme>
          <ControlTheme TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding Left}" />
            <Setter Property="Canvas.Top" Value="{Binding Top}" />
            <Setter Property="Width" Value="{Binding Width}" />
            <Setter Property="Height" Value="{Binding Height}" />
          </ControlTheme>
        </ItemsControl.ItemContainerTheme>
      </ItemsControl>
    </Canvas>
  </Viewbox>
</Window>
