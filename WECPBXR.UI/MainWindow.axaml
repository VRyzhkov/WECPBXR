<Window x:Class="WECPBXR.UI.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WECPBXR.UI.ViewModels"
        Title="WECPBXR"
        Icon="/Assets/midi-connector.png"
        Width="1000"
        Height="760"
        MinWidth="1000"
        MinHeight="760"
        CanResize="False"
        WindowDecorations="None"
        Background="Transparent"
        FontFamily="Segoe UI"
        PointerPressed="Window_PointerPressed">
  <Window.Styles>
    <Style Selector="Button.panel">
      <Setter Property="Height" Value="28" />
      <Setter Property="MinWidth" Value="36" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="#EAF0F7" />
      <Setter Property="Background" Value="#303640" />
      <Setter Property="BorderBrush" Value="#68727F" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="Button.window-control">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="#F5F7FA" />
      <Setter Property="Background" Value="#323842" />
      <Setter Property="BorderBrush" Value="#59616E" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>

    <Style Selector="TextBox.panel">
      <Setter Property="Height" Value="28" />
      <Setter Property="Width" Value="90" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Foreground" Value="#EAF0F7" />
      <Setter Property="Background" Value="#171A20" />
      <Setter Property="BorderBrush" Value="#59616E" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="10" />
    </Style>

    <Style Selector="ComboBox.panel">
      <Setter Property="Height" Value="28" />
      <Setter Property="Width" Value="96" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Foreground" Value="#11151B" />
      <Setter Property="Background" Value="#C2CAD4" />
      <Setter Property="BorderBrush" Value="#59616E" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="10" />
    </Style>
  </Window.Styles>

  <Window.Resources>
    <DataTemplate x:Key="MidiDeviceTemplate">
      <TextBlock Text="{Binding Name}" />
    </DataTemplate>

    <DataTemplate x:Key="ValueBarsTemplate" DataType="vm:ControlSlotViewModel">
      <StackPanel>
        <Grid Height="5" Margin="8,2,8,1" HorizontalAlignment="Stretch">
          <Border Background="#11151B" BorderBrush="#3D4550" BorderThickness="1" />
          <Rectangle Fill="#4BA3FF"
                     Width="{Binding ControllerBarWidth}"
                     HorizontalAlignment="Left"
                     Margin="1" />
        </Grid>
        <Grid Height="5" Margin="8,1,8,0" HorizontalAlignment="Stretch">
          <Border Background="#11151B" BorderBrush="#3D4550" BorderThickness="1" />
          <Rectangle Fill="#F2C84B"
                     Width="{Binding MixerBarWidth}"
                     HorizontalAlignment="Left"
                     Margin="1" />
        </Grid>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="KnobTemplate" DataType="vm:ControlSlotViewModel">
      <Grid ToolTip.Tip="{Binding BindingText}" PointerPressed="ControlSlot_PointerPressed">
        <Grid.RowDefinitions>
          <RowDefinition Height="18" />
          <RowDefinition Height="52" />
          <RowDefinition Height="16" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Text="{Binding Label}"
                   Foreground="#EDF2F7"
                   FontSize="9"
                   FontWeight="SemiBold"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <Grid Grid.Row="1">
          <Ellipse Width="46"
                   Height="46"
                   Fill="#20242C"
                   Stroke="#515A67"
                   StrokeThickness="2" />
          <Ellipse Width="34"
                   Height="34"
                   Fill="#353A45"
                   Stroke="#0E1015"
                   StrokeThickness="2" />
          <Rectangle Width="4"
                     Height="19"
                     Fill="#9BA7B6"
                     RadiusX="2"
                     RadiusY="2"
                     VerticalAlignment="Top"
                     Margin="0,6,0,0" />
        </Grid>
        <ContentControl Grid.Row="2" Content="{Binding}" ContentTemplate="{StaticResource ValueBarsTemplate}" />
        <Border Grid.RowSpan="3"
                BorderBrush="{Binding SelectionBorderBrush}"
                BorderThickness="{Binding SelectionBorderThickness}"
                CornerRadius="6"
                IsHitTestVisible="False" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ButtonTemplate" DataType="vm:ControlSlotViewModel">
      <Grid ToolTip.Tip="{Binding BindingText}" PointerPressed="ControlSlot_PointerPressed">
        <Border Background="#C2CAD4"
                BorderBrush="#050609"
                BorderThickness="3"
                CornerRadius="3">
          <TextBlock Text="{Binding Label}"
                     Foreground="#202630"
                     FontSize="8"
                     FontWeight="Bold"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center"
                     Margin="3,0" />
        </Border>
        <Border BorderBrush="{Binding SelectionBorderBrush}"
                BorderThickness="{Binding SelectionBorderThickness}"
                CornerRadius="5"
                IsHitTestVisible="False" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="FaderTemplate" DataType="vm:ControlSlotViewModel">
      <Grid ToolTip.Tip="{Binding BindingText}" PointerPressed="ControlSlot_PointerPressed">
        <Grid.RowDefinitions>
          <RowDefinition Height="22" />
          <RowDefinition Height="102" />
          <RowDefinition Height="18" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Label}"
                   Foreground="#F3F6FA"
                   FontSize="10"
                   FontWeight="SemiBold"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <Grid Grid.Row="1">
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="0,0,0,4">
            <StackPanel Margin="0,0,5,0">
              <Rectangle Width="13" Height="1" Fill="#89919C" Margin="0,0,0,9" />
              <Rectangle Width="13" Height="1" Fill="#89919C" Margin="0,0,0,9" />
              <Rectangle Width="13" Height="1" Fill="#89919C" Margin="0,0,0,9" />
              <Rectangle Width="13" Height="1" Fill="#89919C" Margin="0,0,0,9" />
              <Rectangle Width="13" Height="1" Fill="#89919C" />
            </StackPanel>
            <Grid>
              <Rectangle Width="12"
                         Height="96"
                         Fill="#0C0D10"
                         Stroke="#3D4550"
                         StrokeThickness="2"
                         RadiusX="3"
                         RadiusY="3" />
              <Border Width="34"
                      Height="18"
                      Background="#262B34"
                      BorderBrush="#11151B"
                      BorderThickness="2"
                      CornerRadius="2"
                      VerticalAlignment="Bottom"
                      Margin="0,0,0,10" />
            </Grid>
            <StackPanel Margin="5,0,0,0">
              <Rectangle Width="13" Height="1" Fill="#89919C" Margin="0,0,0,9" />
              <Rectangle Width="13" Height="1" Fill="#89919C" Margin="0,0,0,9" />
              <Rectangle Width="13" Height="1" Fill="#89919C" Margin="0,0,0,9" />
              <Rectangle Width="13" Height="1" Fill="#89919C" Margin="0,0,0,9" />
              <Rectangle Width="13" Height="1" Fill="#89919C" />
            </StackPanel>
          </StackPanel>
        </Grid>
        <ContentControl Grid.Row="2" Content="{Binding}" ContentTemplate="{StaticResource ValueBarsTemplate}" />
        <Border Grid.RowSpan="3"
                BorderBrush="{Binding SelectionBorderBrush}"
                BorderThickness="{Binding SelectionBorderThickness}"
                CornerRadius="6"
                IsHitTestVisible="False" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="AkaiKnobTemplate" DataType="vm:ControlSlotViewModel">
      <Grid ToolTip.Tip="{Binding BindingText}" PointerPressed="ControlSlot_PointerPressed">
        <Grid.RowDefinitions>
          <RowDefinition Height="16" />
          <RowDefinition Height="60" />
          <RowDefinition Height="14" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Label}"
                   Foreground="#F4F4F2"
                   FontSize="8"
                   FontWeight="SemiBold"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <Grid Grid.Row="1">
          <Ellipse Width="56" Height="56"
                   Stroke="#D9D9D5"
                   StrokeThickness="3"
                   StrokeDashArray="1,3" />
          <Ellipse Width="44" Height="44"
                   Fill="#111214"
                   Stroke="#050506"
                   StrokeThickness="3" />
          <Ellipse Width="34" Height="34"
                   Fill="#303238"
                   Stroke="#565960"
                   StrokeThickness="1" />
          <Rectangle Width="4" Height="20"
                     Fill="#F1F1ED"
                     RadiusX="2" RadiusY="2"
                     VerticalAlignment="Top"
                     Margin="0,11,0,0" />
        </Grid>
        <ContentControl Grid.Row="2" Content="{Binding}" ContentTemplate="{StaticResource ValueBarsTemplate}" />
        <Border Grid.RowSpan="3"
                BorderBrush="{Binding SelectionBorderBrush}"
                BorderThickness="{Binding SelectionBorderThickness}"
                CornerRadius="6"
                IsHitTestVisible="False" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="AkaiButtonTemplate" DataType="vm:ControlSlotViewModel">
      <Grid ToolTip.Tip="{Binding BindingText}" PointerPressed="ControlSlot_PointerPressed">
        <Grid.RowDefinitions>
          <RowDefinition Height="11" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Text="{Binding AkaiHardwareLabel}"
                   Foreground="#EFEFEC"
                   FontSize="7"
                   FontWeight="SemiBold"
                   TextAlignment="Center" />
        <Border Grid.Row="1"
                Background="#090A0C"
                BorderBrush="#08090A"
                BorderThickness="2"
                CornerRadius="4"
                Padding="3">
          <Border Background="{Binding AkaiButtonBrush}"
                  BorderBrush="#F5C8A0"
                  BorderThickness="1"
                  CornerRadius="3">
            <TextBlock Text="{Binding Label}"
                       Foreground="#25262A"
                       FontSize="7"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       Margin="2,0" />
          </Border>
        </Border>
        <Border Grid.RowSpan="2"
                BorderBrush="{Binding SelectionBorderBrush}"
                BorderThickness="{Binding SelectionBorderThickness}"
                CornerRadius="5"
                IsHitTestVisible="False" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="AkaiFaderTemplate" DataType="vm:ControlSlotViewModel">
      <Grid ToolTip.Tip="{Binding BindingText}" PointerPressed="ControlSlot_PointerPressed">
        <Grid.RowDefinitions>
          <RowDefinition Height="18" />
          <RowDefinition Height="108" />
          <RowDefinition Height="14" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Label}"
                   Foreground="#F4F4F2"
                   FontSize="9"
                   FontWeight="SemiBold"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <Grid Grid.Row="1">
          <Border Width="48" Height="104"
                  Background="#101113"
                  BorderBrush="#050506"
                  BorderThickness="3"
                  CornerRadius="5" />
          <Rectangle Width="7" Height="90"
                     Fill="#050506"
                     Stroke="#31343A"
                     StrokeThickness="1"
                     RadiusX="2" RadiusY="2" />
          <Border Width="42" Height="24"
                  Background="#34363A"
                  BorderBrush="#0A0B0D"
                  BorderThickness="2"
                  CornerRadius="2"
                  VerticalAlignment="Bottom"
                  Margin="0,0,0,14">
            <StackPanel VerticalAlignment="Center">
              <Rectangle Height="1" Fill="#8A8D91" Margin="4,0,4,3" />
              <Rectangle Height="1" Fill="#8A8D91" Margin="4,0" />
            </StackPanel>
          </Border>
        </Grid>
        <ContentControl Grid.Row="2" Content="{Binding}" ContentTemplate="{StaticResource ValueBarsTemplate}" />
        <Border Grid.RowSpan="3"
                BorderBrush="{Binding SelectionBorderBrush}"
                BorderThickness="{Binding SelectionBorderThickness}"
                CornerRadius="6"
                IsHitTestVisible="False" />
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Viewbox Stretch="Uniform">
    <Canvas Width="960" Height="724">
      <Border Canvas.Left="50"
              Canvas.Top="20"
              Width="884"
              Height="680"
              Background="#24262D"
              BorderBrush="#050609"
              BorderThickness="4"
              CornerRadius="28"
              IsVisible="{Binding IsWorldeProfile}" />

      <Border Canvas.Left="16"
              Canvas.Top="12"
              Width="928"
              Height="700"
              BorderBrush="#08090A"
              BorderThickness="5"
              CornerRadius="26"
              IsVisible="{Binding IsAkaiProfile}">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#26272A" Offset="0" />
            <GradientStop Color="#303136" Offset="0.72" />
            <GradientStop Color="#45464A" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>

      <Border Canvas.Left="846"
              Canvas.Top="64"
              Width="92"
              Height="410"
              Background="#173B3C40"
              CornerRadius="12"
              IsVisible="{Binding IsAkaiProfile}" />

      <TextBlock Canvas.Left="78"
                 Canvas.Top="67"
                 Text="{Binding ControllerBrandName}"
                 Foreground="#F5F7FA"
                 FontSize="24"
                 FontWeight="Black"
                 Opacity="0.9"
                 Cursor="Hand"
                 ToolTip.Tip="Right-click to select controller skin">
        <TextBlock.ContextMenu>
          <ContextMenu>
            <MenuItem Header="WORLDE Easycontrol Plus"
                      Command="{Binding SelectControllerProfileCommand}"
                      CommandParameter="wecpbxr-default" />
            <MenuItem Header="AKAI MIDImix"
                      Command="{Binding SelectControllerProfileCommand}"
                      CommandParameter="akai-midimix" />
          </ContextMenu>
        </TextBlock.ContextMenu>
      </TextBlock>

      <TextBlock Canvas.Left="746"
                 Canvas.Top="66"
                 Text="MIDIMIX"
                 Foreground="#F5F7FA"
                 FontSize="25"
                 FontWeight="Bold"
                 Opacity="0.95"
                 IsVisible="{Binding IsAkaiProfile}" />

      <Border Canvas.Left="74"
              Canvas.Top="104"
              Width="112"
              Height="36"
              Background="{Binding BankBrush}"
              BorderBrush="#D8DEE8"
              BorderThickness="1"
              CornerRadius="9"
              IsVisible="{Binding IsWorldeProfile}"
              ToolTip.Tip="{Binding BankTitle}">
        <Border.ContextMenu>
          <ContextMenu>
            <MenuItem Header="1 bank" Command="{Binding SetBankCountCommand}" CommandParameter="1" />
            <MenuItem Header="2 banks" Command="{Binding SetBankCountCommand}" CommandParameter="2" />
            <MenuItem Header="3 banks" Command="{Binding SetBankCountCommand}" CommandParameter="3" />
            <MenuItem Header="4 banks" Command="{Binding SetBankCountCommand}" CommandParameter="4" />
            <MenuItem Header="5 banks" Command="{Binding SetBankCountCommand}" CommandParameter="5" />
            <MenuItem Header="6 banks" Command="{Binding SetBankCountCommand}" CommandParameter="6" />
            <MenuItem Header="7 banks" Command="{Binding SetBankCountCommand}" CommandParameter="7" />
            <MenuItem Header="8 banks" Command="{Binding SetBankCountCommand}" CommandParameter="8" />
            <MenuItem Header="9 banks" Command="{Binding SetBankCountCommand}" CommandParameter="9" />
            <MenuItem Header="10 banks" Command="{Binding SetBankCountCommand}" CommandParameter="10" />
            <MenuItem Header="11 banks" Command="{Binding SetBankCountCommand}" CommandParameter="11" />
            <MenuItem Header="12 banks" Command="{Binding SetBankCountCommand}" CommandParameter="12" />
            <MenuItem Header="13 banks" Command="{Binding SetBankCountCommand}" CommandParameter="13" />
            <MenuItem Header="14 banks" Command="{Binding SetBankCountCommand}" CommandParameter="14" />
            <MenuItem Header="15 banks" Command="{Binding SetBankCountCommand}" CommandParameter="15" />
            <MenuItem Header="16 banks" Command="{Binding SetBankCountCommand}" CommandParameter="16" />
          </ContextMenu>
        </Border.ContextMenu>
        <TextBlock Text="{Binding BankTitle}"
                   Foreground="{Binding BankTextBrush}"
                   FontSize="13"
                   FontWeight="Bold"
                   TextAlignment="Center"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Margin="8,0" />
      </Border>

      <Border Canvas.Left="150"
              Canvas.Top="70"
              Width="174"
              Height="23"
              Background="{Binding BankBrush}"
              BorderBrush="#ECEDEB"
              BorderThickness="1"
              CornerRadius="4"
              IsVisible="{Binding IsAkaiProfile}"
              ToolTip.Tip="{Binding BankTitle}">
        <Border.ContextMenu>
          <ContextMenu>
            <MenuItem Header="1 bank" Command="{Binding SetBankCountCommand}" CommandParameter="1" />
            <MenuItem Header="2 banks" Command="{Binding SetBankCountCommand}" CommandParameter="2" />
            <MenuItem Header="3 banks" Command="{Binding SetBankCountCommand}" CommandParameter="3" />
            <MenuItem Header="4 banks" Command="{Binding SetBankCountCommand}" CommandParameter="4" />
            <MenuItem Header="5 banks" Command="{Binding SetBankCountCommand}" CommandParameter="5" />
            <MenuItem Header="6 banks" Command="{Binding SetBankCountCommand}" CommandParameter="6" />
            <MenuItem Header="7 banks" Command="{Binding SetBankCountCommand}" CommandParameter="7" />
            <MenuItem Header="8 banks" Command="{Binding SetBankCountCommand}" CommandParameter="8" />
            <MenuItem Header="9 banks" Command="{Binding SetBankCountCommand}" CommandParameter="9" />
            <MenuItem Header="10 banks" Command="{Binding SetBankCountCommand}" CommandParameter="10" />
            <MenuItem Header="11 banks" Command="{Binding SetBankCountCommand}" CommandParameter="11" />
            <MenuItem Header="12 banks" Command="{Binding SetBankCountCommand}" CommandParameter="12" />
            <MenuItem Header="13 banks" Command="{Binding SetBankCountCommand}" CommandParameter="13" />
            <MenuItem Header="14 banks" Command="{Binding SetBankCountCommand}" CommandParameter="14" />
            <MenuItem Header="15 banks" Command="{Binding SetBankCountCommand}" CommandParameter="15" />
            <MenuItem Header="16 banks" Command="{Binding SetBankCountCommand}" CommandParameter="16" />
          </ContextMenu>
        </Border.ContextMenu>
        <TextBlock Text="{Binding BankTitle}"
                   Foreground="{Binding BankTextBrush}"
                   FontSize="10"
                   FontWeight="Bold"
                   TextAlignment="Center"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Margin="6,0" />
      </Border>

      <TextBlock Canvas.Left="730"
                 Canvas.Top="632"
                 Text="{Binding SoftwareVersionText}"
                 Foreground="#B7C0CC"
                 FontSize="10"
                 FontWeight="SemiBold"
                 IsVisible="{Binding IsWorldeProfile}"
                 Opacity="0.9" />

      <TextBlock Canvas.Left="730"
                 Canvas.Top="648"
                 Text="{Binding ControllerProfileName}"
                 Foreground="#F5F7FA"
                 FontSize="17"
                 FontWeight="SemiBold"
                 Width="190"
                 TextTrimming="CharacterEllipsis"
                 IsVisible="{Binding IsWorldeProfile}"
                 Opacity="0.95" />

      <TextBlock Canvas.Left="748"
                 Canvas.Top="682"
                 Text="{Binding SoftwareVersionText}"
                 Foreground="#C7C8CA"
                 FontSize="8"
                 FontWeight="SemiBold"
                 IsVisible="{Binding IsAkaiProfile}"
                 Opacity="0.9" />

      <StackPanel Canvas.Left="78" Canvas.Top="31" Orientation="Horizontal" IsVisible="{Binding IsNormalPanelVisible}">
        <Ellipse Width="9" Height="9" Fill="{Binding MixerIndicatorBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
        <TextBox Text="{Binding MixerAddress, Mode=TwoWay}"
                 ToolTip.Tip="{Binding MixerStatus}"
                 Classes="panel" />
        <Button Content="X+" Command="{Binding ConnectMixerCommand}" ToolTip.Tip="Connect to XR" Classes="panel" Margin="0,0,6,0" />
        <Button Content="X-" Command="{Binding DisconnectMixerCommand}" ToolTip.Tip="Disconnect from XR" Classes="panel" Margin="0,0,10,0" />
        <Button Content="Pull" Command="{Binding RequestMixerValuesCommand}" ToolTip.Tip="Request current values for assigned OSC addresses" Classes="panel" Margin="0,0,10,0" />
        <Ellipse Width="9" Height="9" Fill="{Binding MidiIndicatorBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
        <ComboBox ItemsSource="{Binding MidiDevices}"
                  SelectedItem="{Binding SelectedMidiDevice, Mode=TwoWay}"
                  ItemTemplate="{StaticResource MidiDeviceTemplate}"
                  ToolTip.Tip="{Binding MidiStatus}"
                  Classes="panel" />
        <Button Content="R" Command="{Binding RefreshMidiDevicesCommand}" ToolTip.Tip="Refresh MIDI device list" Classes="panel" Margin="0,0,6,0" />
        <Button Content="M+" Command="{Binding ConnectMidiCommand}" ToolTip.Tip="Connect selected MIDI input" Classes="panel" Margin="0,0,6,0" />
        <Button Content="M-" Command="{Binding DisconnectMidiCommand}" ToolTip.Tip="Disconnect MIDI input" Classes="panel" Margin="0,0,10,0" />
        <Button Content="Map" Command="{Binding LoadMapCommand}" ToolTip.Tip="Load MIDI/OSC map from midi-map.json" Classes="panel" Margin="0,0,6,0" />
        <Button Content="Assign" Command="{Binding ToggleAssignmentModeCommand}" ToolTip.Tip="Open function assignment mode" Classes="panel" Margin="0,0,6,0" />
        <Button Content="Check" Command="{Binding CheckMapCommand}" ToolTip.Tip="Check map for duplicate MIDI and missing or unknown OSC bindings" Classes="panel" Margin="0,0,6,0" />
        <Button Content="Upd" Command="{Binding CheckForUpdatesCommand}" ToolTip.Tip="Check GitHub Releases for updates" Classes="panel" />
      </StackPanel>

      <StackPanel Canvas.Left="78" Canvas.Top="31" Orientation="Horizontal" IsVisible="{Binding IsAssignmentPanelVisible}">
        <Button Content="{Binding AssignmentModeText}" Command="{Binding ToggleAssignmentModeCommand}" ToolTip.Tip="Close function assignment mode" Classes="panel" Margin="0,0,4,0" />
        <TextBlock Text="{Binding SelectedSlotText}"
                   Width="70"
                   Foreground="#EAF0F7"
                   FontSize="10"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,0,4,0" />
        <ComboBox ItemsSource="{Binding AssignmentCommands}"
                  SelectedItem="{Binding SelectedAssignmentCommand, Mode=TwoWay}"
                  Width="80"
                  Margin="0,0,4,0"
                  Classes="panel" />
        <TextBox Text="{Binding AssignmentChannel, Mode=TwoWay}" ToolTip.Tip="XR channel 1-18" Width="28" MinWidth="28" MaxWidth="28" Padding="3,4" Margin="0,0,4,0" Classes="panel" />
        <TextBox Text="{Binding AssignmentIndex, Mode=TwoWay}" ToolTip.Tip="Bus/FX index. Empty for main, mute, pan." Width="28" MinWidth="28" MaxWidth="28" Padding="3,4" Margin="0,0,4,0" Classes="panel" />
        <TextBox Text="{Binding AssignmentMidiChannel, Mode=TwoWay}" ToolTip.Tip="MIDI channel 1-16" Width="28" MinWidth="28" MaxWidth="28" Padding="3,4" Margin="0,0,4,0" Classes="panel" />
        <TextBox Text="{Binding AssignmentMidiNumber, Mode=TwoWay}" ToolTip.Tip="MIDI CC number 0-127" Width="28" MinWidth="28" MaxWidth="28" Padding="3,4" Margin="0,0,4,0" Classes="panel" />
        <Button Content="MIDI" Command="{Binding ApplyMidiBindingCommand}" ToolTip.Tip="Assign MIDI Control Change to selected control" Classes="panel" Margin="0,0,4,0" />
        <Button Content="Set" Command="{Binding ApplyAssignmentCommand}" ToolTip.Tip="Assign selected function to selected control" Classes="panel" Margin="0,0,4,0" />
        <Button Content="Clear" Command="{Binding ClearAssignmentCommand}" ToolTip.Tip="Clear mixer function from selected control" Classes="panel" Margin="0,0,4,0" />
        <Button Content="Learn" Command="{Binding LearnMidiCommand}" ToolTip.Tip="Learn MIDI binding from the next physical controller event" Classes="panel" Margin="0,0,4,0" />
        <Button Content="Check" Command="{Binding CheckMapCommand}" ToolTip.Tip="Check map for duplicate MIDI and missing or unknown OSC bindings" Classes="panel" Margin="0,0,4,0" />
        <Button Content="{Binding SaveMapText}" Command="{Binding SaveMapCommand}" ToolTip.Tip="Save current MIDI/OSC map to midi-map.json" Classes="panel" />
      </StackPanel>

      <StackPanel Canvas.Left="806" Canvas.Top="35" Orientation="Horizontal">
        <Button x:Name="ScaleButton"
                Click="ScaleButton_Click"
                Classes="window-control"
                Margin="0,0,8,0"
                ToolTip.Tip="Reduce window size">
          <Grid Width="14" Height="14">
            <Path x:Name="ScaleIcon"
                  Data="M 2 2 L 6 6 M 6 6 L 6 3 M 6 6 L 3 6 M 12 12 L 8 8 M 8 8 L 11 8 M 8 8 L 8 11"
                  Stroke="#F5F7FA"
                  StrokeThickness="1.6"
                  StrokeLineCap="Round"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
          </Grid>
        </Button>
        <Button x:Name="TopmostButton"
                Click="TopmostButton_Click"
                Classes="window-control"
                Margin="0,0,8,0"
                ToolTip.Tip="Pin window on top">
          <Grid Width="14" Height="14">
            <Path x:Name="TopmostPinIcon"
                  Data="M 5 2 L 9 2 M 7 2 L 7 6 M 4 6 L 10 6 M 5 6 L 3 9 M 9 6 L 11 9 M 4 9 L 10 9 M 7 9 L 7 12"
                  Stroke="#F5F7FA"
                  StrokeThickness="1.6"
                  StrokeLineCap="Round"
                  RenderTransformOrigin="50%,50%"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
          </Grid>
        </Button>
        <Button Click="MinimizeButton_Click"
                Classes="window-control"
                Margin="0,0,8,0"
                ToolTip.Tip="Minimize">
          <TextBlock Text="-"
                     Foreground="#F5F7FA"
                     FontSize="16"
                     FontWeight="Bold"
                     TextAlignment="Center"
                     VerticalAlignment="Center"
                     Margin="0,-3,0,0" />
        </Button>
        <Button Click="CloseButton_Click"
                Classes="window-control"
                ToolTip.Tip="Close">
          <Grid Width="14" Height="14">
            <Path Data="M 3 3 L 11 11 M 11 3 L 3 11"
                  Stroke="#F5F7FA"
                  StrokeThickness="2"
                  StrokeLineCap="Round"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
          </Grid>
        </Button>
      </StackPanel>

      <Border Canvas.Left="82"
              Canvas.Top="628"
              Width="630"
              Height="48"
              Background="#D920242B"
              BorderBrush="#59616E"
              BorderThickness="1"
              CornerRadius="4"
              Padding="6"
              IsVisible="{Binding IsWorldeProfile}"
              PointerPressed="LogPanel_PointerPressed"
              ToolTip.Tip="Double-click to copy the log to clipboard">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding LogEntries}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}"
                           Foreground="#D8DEE8"
                           FontSize="10"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,2" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <ItemsControl Width="960" Height="724" ItemsSource="{Binding Knobs}" ItemTemplate="{StaticResource KnobTemplate}" IsVisible="{Binding IsWorldeProfile}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerTheme>
          <ControlTheme TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding Left}" />
            <Setter Property="Canvas.Top" Value="{Binding Top}" />
            <Setter Property="Width" Value="{Binding Width}" />
            <Setter Property="Height" Value="{Binding Height}" />
          </ControlTheme>
        </ItemsControl.ItemContainerTheme>
      </ItemsControl>

      <ItemsControl Width="960" Height="724" ItemsSource="{Binding Buttons}" ItemTemplate="{StaticResource ButtonTemplate}" IsVisible="{Binding IsWorldeProfile}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerTheme>
          <ControlTheme TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding Left}" />
            <Setter Property="Canvas.Top" Value="{Binding Top}" />
            <Setter Property="Width" Value="{Binding Width}" />
            <Setter Property="Height" Value="{Binding Height}" />
          </ControlTheme>
        </ItemsControl.ItemContainerTheme>
      </ItemsControl>

      <ItemsControl Width="960" Height="724" ItemsSource="{Binding Faders}" ItemTemplate="{StaticResource FaderTemplate}" IsVisible="{Binding IsWorldeProfile}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerTheme>
          <ControlTheme TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding Left}" />
            <Setter Property="Canvas.Top" Value="{Binding Top}" />
            <Setter Property="Width" Value="{Binding Width}" />
            <Setter Property="Height" Value="{Binding Height}" />
          </ControlTheme>
        </ItemsControl.ItemContainerTheme>
      </ItemsControl>

      <ItemsControl Width="960" Height="724" ItemsSource="{Binding Knobs}" ItemTemplate="{StaticResource AkaiKnobTemplate}" IsVisible="{Binding IsAkaiProfile}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerTheme>
          <ControlTheme TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding Left}" />
            <Setter Property="Canvas.Top" Value="{Binding Top}" />
            <Setter Property="Width" Value="{Binding Width}" />
            <Setter Property="Height" Value="{Binding Height}" />
          </ControlTheme>
        </ItemsControl.ItemContainerTheme>
      </ItemsControl>

      <ItemsControl Width="960" Height="724" ItemsSource="{Binding Buttons}" ItemTemplate="{StaticResource AkaiButtonTemplate}" IsVisible="{Binding IsAkaiProfile}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerTheme>
          <ControlTheme TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding Left}" />
            <Setter Property="Canvas.Top" Value="{Binding Top}" />
            <Setter Property="Width" Value="{Binding Width}" />
            <Setter Property="Height" Value="{Binding Height}" />
          </ControlTheme>
        </ItemsControl.ItemContainerTheme>
      </ItemsControl>

      <ItemsControl Width="960" Height="724" ItemsSource="{Binding Faders}" ItemTemplate="{StaticResource AkaiFaderTemplate}" IsVisible="{Binding IsAkaiProfile}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerTheme>
          <ControlTheme TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding Left}" />
            <Setter Property="Canvas.Top" Value="{Binding Top}" />
            <Setter Property="Width" Value="{Binding Width}" />
            <Setter Property="Height" Value="{Binding Height}" />
          </ControlTheme>
        </ItemsControl.ItemContainerTheme>
      </ItemsControl>

      <Border Canvas.Left="48"
              Canvas.Top="662"
              Width="665"
              Height="42"
              Background="#E6101113"
              BorderBrush="#5B5D61"
              BorderThickness="1"
              CornerRadius="3"
              Padding="5,2"
              IsVisible="{Binding IsAkaiProfile}"
              PointerPressed="LogPanel_PointerPressed"
              ToolTip.Tip="Double-click to copy the log to clipboard">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding LogEntries}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}"
                           Foreground="#E4E4E1"
                           FontSize="8"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,1" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
    </Canvas>
  </Viewbox>
</Window>
